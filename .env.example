# ─────────────────────────────────────────────────────────────
# Na Mira · Controle de Pragas — variáveis de ambiente
# Copie para `.env` e preencha ao conectar o backend (Supabase/Postgres).
# O app roda 100% standalone com dados de exemplo (seed) sem estas chaves.
# ─────────────────────────────────────────────────────────────

# Fonte de dados: "seed" (padrão, em memória) ou "supabase"
VITE_DATA_SOURCE=seed

# Supabase (Postgres gerenciado) — usado quando VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Integração de mapas / roteirização (opcional)
VITE_GOOGLE_MAPS_API_KEY=
